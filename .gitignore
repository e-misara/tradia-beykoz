# Beykoz analiz scriptleri whitelist (Patron kararı 28 Tem)
# CC-Signals SIG7/SIG8 üretim scriptleri repo'da tutulur — şeffaflık ve tekrar-üretilebilirlik için.
!beykoz_vaka/**/*.py

# Arsiv PRIVATE içerik — asla PUBLIC repo'ya girmez
arsiv/tam/

# Arsiv script whitelist (Standing #37 · saf Python · AI çağrısı yok)
!arsiv/*.py

# Pano HTML whitelist (BE-01 · vanilla JS statik pano)
!pano/*.html


# MISARA MU-01 whitelist (Standing #41 · yerel masaüstü uygulaması)
!misara-app/*.html
!misara-app/*.css
!misara-app/*.js
!misara-app/*.py
!misara-app/*.plist
!misara-app/*.command
!misara-app/veri/*.json
